<Project>
  <!-- Copy to local.props (git-ignored) and point GameDir at your Obenseuer install. -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Obenseuer</GameDir>
    <!-- Optional: BepInEx core folder if it is not in the game folder (e.g. a mod manager's staging folder). -->
    <!-- <BepInExCore>D:\Mods\BepInEx\core</BepInExCore> -->
    <!-- Optional: deploy target for dotnet build -p:Deploy=true. Defaults to <GameDir>\BepInEx\plugins\NoFussLocks. -->
    <!-- <DeployDir>D:\ModManager\mods\NoFussLocks</DeployDir> -->
  </PropertyGroup>
</Project>
